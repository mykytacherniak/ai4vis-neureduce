


import pandas as pd
import numpy as np
import matplotlib.pyplot as plt


df = pd.read_csv("../../data/predictions_test.csv")
df.head()


n_samples, n_labels = df.shape

print(f"Number of samples: {n_samples}")
print(f"Number of labels : {n_labels}")


num_of_test_samples = (df["split"] == "test").sum()

print(f"Number of test samples: {num_of_test_samples}") 


print("Labels and their dtypes:")

df.dtypes


df.columns








df_train = pd.read_csv("../../data/predictions_train.csv")

num_of_train_samples = (df_train["split"] == "train").sum()

print(f"Number of train samples: {num_of_train_samples}")





accuracy_test = df["correct"].sum() / num_of_test_samples
accuracy_train = df_train["correct"].sum() / num_of_train_samples

print(f"Accuracy on the test set : {accuracy_test:.4f}")
print(f"Accuracy on the train set: {accuracy_train:.4f}")
print(f"accuracy_train - accuracy_test = {accuracy_train - accuracy_test:.4f}")















